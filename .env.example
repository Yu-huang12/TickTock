# Copy this file to ".env" and fill in your Supabase project values.
# Find them in the Supabase dashboard → Project Settings → API.
#
# IMPORTANT: also enable anonymous sign-ins:
#   Dashboard → Authentication → Providers → Anonymous → Enable
# And run supabase/schema.sql once in the SQL editor.
#
# The anon key is a public client key — safe to ship in a frontend app.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
